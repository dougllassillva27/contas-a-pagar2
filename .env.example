# ==========================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seus valores REAIS
# NUNCA commite o arquivo .env real no repositório
# ==========================================

# Conexão do Banco Neon (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require

# Senha de Acesso ao Sistema (use senhas fortes e únicas)
SENHA_MESTRA=sua_senha_mestra_aqui
SENHA_VITORIA=sua_senha_vitoria_aqui

# Token para Integração Externa (API - Postman/Automator)
# Crie uma senha DIFERENTE da SENHA_MESTRA para integrações
API_TOKEN=seu_token_api_aqui

# Segredo da Sessão (mínimo 32 caracteres aleatórios)
SESSION_SECRET=gerar_string_aleatoria_com_pelo_menos_32_caracteres

# Porta do Servidor
PORT=3000

# Versão do Node (Render)
NODE_VERSION=18

# Bot Telegram
# Token do bot obtido no @BotFather (https://t.me/botfather)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui
# Seu Chat ID (descubra enviando /start para @userinfobot)
TELEGRAM_CHAT_ID=seu_chat_id_aqui
# String aleatória para proteger a URL do webhook
TELEGRAM_WEBHOOK_SECRET=segredo_webhook_aleatorio
# URL pública da aplicação (ex: Render, Railway)
RENDER_EXTERNAL_URL=https://sua-app.onrender.com
