<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'Gestão Financeira - Login' %></title>

    <!-- Meta Tags para Preview Social (Open Graph / WhatsApp / Telegram) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Acesso ao Painel • Gestão Financeira">
    <meta property="og:description" content="Controle financeiro simples, claro e compartilhado. Tudo em um só lugar.">
    <meta property="og:image" content="https://contas-a-pagar-nsti.onrender.com/social-media.webp?v=4">
    <meta property="og:url" content="https://contas-a-pagar-nsti.onrender.com/login">
    <meta property="og:site_name" content="Gestão Financeira">

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Acesso ao Painel • Gestão Financeira">
    <meta name="twitter:description" content="Controle financeiro simples, claro e compartilhado. Tudo em um só lugar.">
    <meta name="twitter:image" content="https://contas-a-pagar-nsti.onrender.com/social-media.webp?v=4">

    <!-- PWA Setup -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#121212" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="/social-media.webp" />
    <script nonce="<%= cspNonce %>">
  if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => console.log('SW falhou:', err));
        });
      }
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico"/> 
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="login-body">

    <div class="login-container">
        <div class="login-card">
            
            <div class="login-icon">
                <span class="material-icons">lock</span>
            </div>

            <h2>Bem-vindo de volta</h2>
            <span class="login-subtitle">Gerencie suas finanças com segurança</span>

            <% if (error) { %>
            <div class="error-msg">
                <span class="material-icons" style="font-size: 14px; vertical-align: middle; margin-right: 5px;">error</span>
                <%= error %>
            </div>
            <% } %>

            <form action="/login" method="POST" class="login-form" id="loginForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label for="login">Login / Usuário</label>
                    <input 
                        type="text" 
                        name="login" 
                        id="login" 
                        class="login-input" 
                        placeholder="Ex: douglas" 
                        required 
                        autofocus
                        autocomplete="username"
                    >
                </div>

                <div class="form-group" style="margin-top: 15px;">
                    <label for="password">Senha de Acesso</label>
                    <input 
                        type="password" 
                        name="password" 
                        id="password" 
                        class="login-input" 
                        placeholder="••••••••" 
                        required 
                        autocomplete="current-password"
                    >
                </div>
                
                <!-- Checkbox Lembrar de Mim -->
                <div class="remember-group">
                    <label class="custom-checkbox-wrapper" for="lembrar">
                        <input type="checkbox" name="lembrar" id="lembrar" value="on" class="hidden-checkbox">
                        <div class="custom-checkbox"></div>
                        <span class="remember-text">Lembrar de mim</span>
                    </label>
                </div>

                <button type="submit" class="login-btn">
                    <span class="material-icons" style="font-size: 18px; margin-right: 8px;">login</span>
                    Entrar no Sistema
                </button>
            </form>

            <div style="margin-top: 20px; font-size: 0.9rem; color: var(--text-secondary);">
                Não tem uma conta? <a href="/signup" style="color: var(--primary); font-weight: 600; text-decoration: none;">Cadastre-se</a>
            </div>

            <div class="login-footer">
                &copy; <%= new Date().getFullYear() %> Gestão Financeira • Acesso Seguro
            </div>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        // Monitora submit do form
        document.getElementById('loginForm')?.addEventListener('submit', (e) => {
            // Não previne o submit - deixa o form fazer POST tradicional
        });
    </script>
</body>
</html>