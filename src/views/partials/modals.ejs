<%# ================= MODAL: WIZARD DE ONBOARDING ================= %>
<div class="modal-overlay" id="modalWizard">
  <div class="modal-box" style="max-width: 500px">
    <div class="modal-header">
      <h2>Configuração Inicial</h2>
      <button class="modal-close" onclick="fecharModalWizard()">&times;</button>
    </div>
    <div class="modal-scroll" id="wizardContent">
      
      <!-- Passo 1: Bem-vindo -->
      <div class="wizard-step active" data-step="1">
        <div style="text-align: center; margin-bottom: 20px;">
          <span class="material-icons" style="font-size: 48px; color: var(--primary);">auto_awesome</span>
          <h3 style="margin-top: 10px;">Bem-vindo à sua Gestão Financeira!</h3>
          <p style="color: var(--text-secondary); font-size: 0.9rem;">Vamos configurar o básico para você começar.</p>
        </div>
        <div class="form-group">
          <label>Qual o nome do seu parceiro(a) principal?</label>
          <input type="text" id="wizardPartnerName" class="form-input" placeholder="Ex: Vitória, João..." />
          <small style="color: var(--text-secondary); font-size: 0.75rem;">Usaremos este nome para identificar as contas divididas.</small>
        </div>
        <div style="text-align: right; margin-top: 30px; display: flex; justify-content: space-between; align-items: center;">
          <button class="modal-tab" style="padding: 0; font-size: 0.8rem;" onclick="finalizarWizardSozinho()">Vou usar sozinho</button>
          <button class="btn-primary" style="width: auto; padding: 10px 25px;" onclick="wizardNextStep()">Próximo Passo</button>
        </div>
      </div>

      <!-- Passo 2: Sincronização -->
      <div class="wizard-step" data-step="2" style="display: none;">
        <h3 style="margin-bottom: 15px;">Sincronização Automática</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 20px;">
          Seu parceiro(a) também usa o sistema? Insira o ID dele(a) para espelhar as contas automaticamente.
        </p>
        <div class="form-group">
          <label>ID do Usuário do Parceiro (Opcional)</label>
          <input type="number" id="wizardPartnerID" class="form-input" placeholder="Ex: 2" />
          <small style="color: var(--text-secondary); font-size: 0.75rem;">Deixe vazio se não quiser sincronizar agora.</small>
        </div>
        <div style="display: flex; justify-content: space-between; margin-top: 30px; align-items: center;">
          <button class="modal-tab" style="padding: 0; font-size: 0.8rem;" onclick="wizardPrevStep()">Voltar</button>
          <button class="modal-tab" style="padding: 0; font-size: 0.8rem;" onclick="finalizarWizardSozinho()">Pular tudo</button>
          <button class="btn-primary" style="width: auto; padding: 10px 25px;" onclick="wizardNextStep()">Próximo Passo</button>
        </div>
      </div>

      <!-- Passo 3: Divisão Casa -->
      <div class="wizard-step" data-step="3" style="display: none;">
        <h3 style="margin-bottom: 15px;">Regra de Divisão "Casa"</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 20px;">
          Vocês dividem as contas da casa ao meio (50/50)?
        </p>
        <div class="form-group" style="display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.03); padding: 15px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
          <input type="checkbox" id="wizardEnableCasa" checked style="width: 20px; height: 20px;" />
          <label for="wizardEnableCasa" style="margin-bottom: 0; cursor: pointer; font-weight: 500;">
            Sim, criar regra automática para "Casa"
          </label>
        </div>
        <p style="color: var(--text-secondary); font-size: 0.75rem; margin-top: 10px;">
          Ao marcar, qualquer lançamento com o terceiro "Casa" será automaticamente dividido com seu parceiro.
        </p>
        <div style="display: flex; justify-content: space-between; margin-top: 30px; align-items: center;">
          <button class="modal-tab" style="padding: 0; font-size: 0.8rem;" onclick="wizardPrevStep()">Voltar</button>
          <button class="modal-tab" style="padding: 0; font-size: 0.8rem;" onclick="finalizarWizardSozinho()">Pular tudo</button>
          <button class="btn-primary" style="width: auto; padding: 10px 25px;" onclick="finalizarWizard()">Finalizar Configuração</button>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="modal-overlay" id="modalAdicionar">
  <div class="modal-box">
    <div class="modal-header">
      <h2 id="modalTitulo">Adicionar Lançamento</h2>
      <button class="modal-close" onclick="fecharModais()">&times;</button>
    </div>
    <div class="modal-grid" id="modalGridForm">
      <div class="form-wrapper" id="colRenda">
        <h3 id="tituloRenda" style="margin-bottom: 20px; color: var(--text-secondary)">Nova Renda</h3>
        <form id="formRenda" onsubmit="enviarLancamento(event, 'RENDA')">
          <input type="hidden" name="id" id="rendaId" />
          <div class="form-group">
            <label>Descrição</label>
            <input type="text" name="descricao" id="rendaDesc" class="form-input" placeholder="Ex: Salário" required />
          </div>
          <div class="form-group">
            <label>Valor</label>
            <input type="text" name="valor" id="rendaValor" class="form-input" placeholder="R$ 0,00" required />
          </div>
          <div class="form-group">
            <label>Tipo</label>
            <select name="sub_tipo" id="rendaCat" class="form-select">
              <option value="Salário">Salário</option>
              <option value="Extra">Extra</option>
            </select>
          </div>
          <button type="submit" id="btnSalvarRenda" class="btn-primary form-btn">+ Adicionar Renda</button>
        </form>
      </div>
      <div class="form-wrapper" id="colConta">
        <h3 id="tituloConta" style="margin-bottom: 20px; color: var(--text-secondary)">Nova Conta</h3>
        <form id="formConta" onsubmit="enviarLancamento(event, 'CONTA')">
          <input type="hidden" name="id" id="contaId" />
          <div class="form-group">
            <label>Descrição</label>
            <input type="text" name="descricao" id="contaDesc" class="form-input" placeholder="Ex: Netflix" required />
          </div>
          <div class="form-group">
            <label>Valor</label>
            <input type="text" name="valor" id="contaValor" class="form-input" placeholder="R$ 0,00" required />
          </div>
          <div class="form-group">
            <label>Tipo de Conta</label>
            <select name="sub_tipo" id="contaTipo" class="form-select" onchange="toggleParcelas()">
              <option value="Única">Única</option>
              <option value="Parcelada">Parcelada</option>
              <option value="Fixa">Fixa</option>
            </select>
          </div>
          <div class="form-group" id="grupoParcelas" style="display: none">
            <label>Parcelas (Atual/Total)</label>
            <input type="text" name="parcelas" id="contaParcelas" class="form-input" placeholder="00/00" maxlength="5" oninput="mascaraParcela(this)" />
          </div>

          <div class="form-group" id="grupoTerceiroSingle">
            <label>Nome do Terceiro (Opcional)</label>
            <input type="text" name="nome_terceiro" id="contaTerceiro" class="form-input" list="nomesTerceiros" placeholder="Ex: Eu, Morr, Casa (use vírgula para lote)" oninput="atualizarBulkCounterNative(this)" />
            <datalist id="nomesTerceiros">
              <% if (typeof terceirosDistinct !== 'undefined' && terceirosDistinct.length > 0) { %>
                <% terceirosDistinct.forEach(nome => { %>
                  <option value="<%= nome %>"></option>
                <% }) %>
              <% } %>
            </datalist>
            <small id="bulkCounterNative" style="color: var(--blue); display: none; margin-top: 5px; font-weight: 500;"></small>
          </div>

          <button type="submit" id="btnSalvarConta" class="btn-primary form-btn" style="background-color: #444">+ Adicionar Conta</button>
        </form>
      </div>
    </div>
  </div>
</div>

