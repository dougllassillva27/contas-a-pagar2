      <button class="btn-cancel" style="width: 100%; margin: 0; margin-top: 5px;" onclick="fecharModalCompartilhar()">Cancelar</button>
    </div>
  </div>
</div>

<%# ================= MODAL: CONFIGURAÇÕES ================= %>
<div class="modal-overlay" id="modalConfiguracoes">
  <div class="modal-box" style="max-width: 500px">
    <div class="modal-header">
      <h2 id="modalTituloConfig">Configurações</h2>
      <button class="modal-close" onclick="fecharModalConfiguracoes()">&times;</button>
    </div>
    <div class="modal-scroll">
      <div class="modal-tabs">
        <button class="modal-tab active" onclick="switchTab('tab-geral', this)">Geral</button>
        <button class="modal-tab" onclick="switchTab('tab-sync', this)">Sincronização</button>
      </div>

      <!-- ABA GERAL -->
      <div id="tab-geral" class="tab-content active">
        <form id="formConfig">
          <div class="form-group">
            <label for="configDivisaoMinimo">Valor Mínimo da Divisão "Casa"</label>
            <input type="text" id="configDivisaoMinimo" class="form-input" placeholder="R$ 750,00" />
            <small style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 5px;">
              Define o valor base para a divisão da conta "Casa". Se a fatura for menor, este valor será usado.
            </small>
          </div>
          <div style="text-align: right; margin-top: 20px;">
            <button type="submit" class="btn-primary" style="width: auto; padding: 10px 25px;">Salvar Configurações</button>
          </div>
        </form>
      </div>

      <!-- ABA SINCRONIZAÇÃO -->
      <div id="tab-sync" class="tab-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
          <h3 style="margin: 0; font-size: 1rem;">Regras Ativas</h3>
          <button class="btn-primary" style="width: auto; padding: 6px 12px; font-size: 0.8rem;" onclick="abrirFormNovaRegra()">+ Nova Regra</button>
        </div>
        <div id="listaRegrasSync">
          <!-- Injetado via JS -->
          <div style="text-align: center; padding: 20px; color: var(--text-secondary);">
            Carregando regras...
          </div>
        </div>
      </div>
    </div>
<!-- Footer removido para as abas terem botões próprios se necessário ou simplificar -->
  </div>
</div>

<%# ================= MODAL: REGRA DE SINCRONIZAÇÃO ================= %>
<div class="modal-overlay" id="modalRegraSync">
  <div class="modal-box" style="max-width: 450px">
    <div class="modal-header">
      <h2 id="tituloModalRegraSync">Nova Regra</h2>
      <button class="modal-close" onclick="fecharModalRegraSync()">&times;</button>
    </div>
    <div class="modal-scroll">
      <form id="formRegraSync">
        <input type="hidden" id="syncRuleIndex" value="-1" />
        
        <div class="form-group">
          <label>Tipo de Sincronização</label>
          <select id="syncType" class="form-select" onchange="toggleSyncFields()" required>
            <option value="COPIA_TOTAL">Cópia Total (Espelhamento)</option>
            <option value="DIVISAO_CASA">Divisão Casa (Proporcional)</option>
          </select>
        </div>

        <div class="form-group">
          <label>Terceiro de Origem (Nesta Conta)</label>
          <input type="text" id="syncTerceiroOrigem" class="form-input" placeholder="Ex: Casa" required />
          <small style="color: var(--text-secondary); font-size: 0.75rem;">O nome do terceiro que dispara a regra.</small>
        </div>

        <div class="form-group">
          <label>ID do Usuário de Destino</label>
          <input type="number" id="syncUsuarioDestino" class="form-input" placeholder="Ex: 2" required />
          <small style="color: var(--text-secondary); font-size: 0.75rem;">ID do usuário que receberá o lançamento.</small>
        </div>

        <!-- Campos para COPIA_TOTAL -->
        <div id="fieldsCopiaTotal" class="sync-type-fields">
          <div class="form-group">
            <label>Conta de Destino (No outro usuário)</label>
            <input type="text" id="syncContaDestino" class="form-input" placeholder="Ex: Cartão Douglas" />
          </div>
        </div>

        <!-- Campos para DIVISAO_CASA -->
        <div id="fieldsDivisaoCasa" class="sync-type-fields" style="display: none;">
          <div class="form-group">
            <label>Valor Mínimo (R$)</label>
            <input type="number" step="0.01" id="syncValorMinimo" class="form-input" placeholder="750.00" />
          </div>
          <div class="form-group">
            <label>Terceiro Espelho no Origem (Opcional)</label>
            <input type="text" id="syncTerceiroEspelho" class="form-input" placeholder="Ex: Morr" />
            <small style="color: var(--text-secondary); font-size: 0.75rem;">Cria uma cópia do valor dividido para outro terceiro nesta conta.</small>
          </div>
        </div>

        <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-top: 15px;">
          <input type="checkbox" id="syncAtivo" checked style="width: 18px; height: 18px;" />
          <label for="syncAtivo" style="margin-bottom: 0; cursor: pointer;">Regra Ativa</label>
        </div>
      </form>
    </div>
    <div class="modal-footer" style="text-align: right; margin-top: 20px;">
      <button type="submit" form="formRegraSync" class="btn-primary" style="width: auto; padding: 10px 25px;">Salvar Regra</button>
    </div>
  </div>
</div>

